# PKGBUILD for proton-vpn-manager (multi-tunnel add-on)
# Maintainer: Proton VPN Engineering <engineering@protonvpn.com>
# License: GPL3
# URL: https://github.com/ProtonMail/python-protonvpn-cli

pkgname=proton-vpn-manager
pkgver=0.1.8
pkgrel=2
pkgdesc="Proton VPN Tunnel Manager daemon for multi-tunnel VPN with network namespace isolation"
arch=('any')
url="https://github.com/ProtonMail/python-protonvpn-cli"
license=('GPL3')
depends=(
    'python'
    'python-dbus-fast'
    'python-pydantic'
    'python-asyncstdlib'
    'python-pyroute2'
    'iproute2'
    'nsenter'
)
makedepends=(
    'python-setuptools'
    'python-build'
    'python-installer'
    'python-wheel'
)
optdepends=(
    'proton-vpn-cli: Multi-tunnel VPN support (tunnel commands)'
)
backup=(
    'etc/polkit-1/rules.d/60-protonvpn-manager.rules'
)
install="${pkgname}.install"

# No source download - build from current repository state using makepkg -e
# This PKGBUILD is designed to be run from the multi-tunnel-namespace directory
source=()
noextract=()

prepare() {
    # Nothing to prepare; we build directly from the existing source
    :
}

build() {
    # Build libvpnmanager wheel from local source
    cd "${srcdir}/../src"
    pip wheel . --wheel-dir "${srcdir}" --no-deps
}

package() {
    cd "${srcdir}"

    # Install Python package from wheel
    python -m installer --destdir="${pkgdir}" *.whl

    # Install daemon script
    install -Dm755 "${srcdir}/../src/daemon/daemon.py" \
        "${pkgdir}/usr/bin/proton-vpn-manager"

    # Install systemd service
    install -Dm644 "${srcdir}/../packaging/systemd/usr/lib/systemd/system/proton-vpn-manager.service" \
        "${pkgdir}/usr/lib/systemd/system/proton-vpn-manager.service"

    # Install polkit rules
    install -Dm644 "${srcdir}/../packaging/polkit/60-protonvpn-manager.rules" \
        "${pkgdir}/etc/polkit-1/rules.d/60-protonvpn-manager.rules"

    # Install documentation
    local docdir="${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 "${srcdir}/../../README.md" "${docdir}/README.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../../MULTI_TUNNEL_ARCHITECTURE.md" "${docdir}/ARCHITECTURE.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../README.md" "${docdir}/LIBVPNMANAGER.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../../IMPLEMENTATION_REPORT.md" "${docdir}/IMPLEMENTATION_REPORT.md" 2>/dev/null || true
}
