# PKGBUILD for proton-vpn-manager (multi-tunnel add-on)
# Maintainer: Proton VPN Engineering <engineering@protonvpn.com>
# License: GPL3
# URL: https://github.com/ProtonMail/python-protonvpn-cli

pkgname=proton-vpn-manager
pkgver=0.1.8
pkgrel=1
pkgdesc="Proton VPN Tunnel Manager daemon for multi-tunnel VPN with network namespace isolation"
arch=('any')
url="https://github.com/ProtonMail/python-protonvpn-cli"
license=('GPL3')
depends=(
    'python'
    'python-dbus-fast'
    'python-pydantic'
    'python-asyncstdlib'
    'python-pyroute2'
    'iproute2'
    'nsenter'
)
makedepends=(
    'python-setuptools'
    'python-build'
    'python-installer'
    'python-wheel'
)
optdepends=(
    'proton-vpn-cli: Multi-tunnel VPN support (tunnel commands)'
)
backup=(
    'etc/polkit-1/rules.d/60-protonvpn-manager.rules'
)
install="${pkgname}.install"

# This PKGBUILD builds from the current working directory (multi-tunnel-namespace)
# Usage: makepkg -e -p ./PKGBUILD.work
# -e uses existing source in $SRCDEST (we'll set it to current directory)

prepare() {
    # No source extraction needed; we use the current directory
    :
}

build() {
    # Build libvpnmanager wheel from local source
    cd "${SRCDEST}/src/libvpnmanager"
    python -m build --wheel --skip-dependency-check . --out-dir="${SRCDEST}"
}

package() {
    # Install Python package
    cd "${SRCDEST}"
    python -m installer --destdir="${pkgdir}" *.whl

    # Install daemon script
    install -Dm755 "${SRCDEST}/src/daemon/daemon.py" \
        "${pkgdir}/usr/bin/proton-vpn-manager"

    # Install systemd service
    install -Dm644 "${SRCDEST}/packaging/systemd/usr/lib/systemd/system/proton-vpn-manager.service" \
        "${pkgdir}/usr/lib/systemd/system/proton-vpn-manager.service"

    # Install polkit rules
    install -Dm644 "${SRCDEST}/packaging/polkit/60-protonvpn-manager.rules" \
        "${pkgdir}/etc/polkit-1/rules.d/60-protonvpn-manager.rules"

    # Install documentation
    local docdir="${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 "${SRCDEST}/../README.md" "${docdir}/README.md" 2>/dev/null || true
    install -Dm644 "${SRCDEST}/../MULTI_TUNNEL_ARCHITECTURE.md" "${docdir}/ARCHITECTURE.md" 2>/dev/null || true
    install -Dm644 "${SRCDEST}/README.md" "${docdir}/LIBVPNMANAGER.md" 2>/dev/null || true
    install -Dm644 "${SRCDEST}/../IMPLEMENTATION_REPORT.md" "${docdir}/IMPLEMENTATION_REPORT.md" 2>/dev/null || true
}
