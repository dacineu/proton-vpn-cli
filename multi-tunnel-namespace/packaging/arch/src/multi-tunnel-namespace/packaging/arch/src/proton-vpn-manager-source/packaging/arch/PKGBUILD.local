# PKGBUILD for proton-vpn-manager (Arch Linux)
# This builds the daemon from the local source tree

pkgname=proton-vpn-manager
pkgver=0.1.8
pkgrel=1
pkgdesc="Proton VPN Tunnel Manager - Multi-tunnel VPN with network namespace isolation"
arch=('any')
url="https://github.com/ProtonMail/python-protonvpn-cli"
license=('GPL3')
depends=(
    'python'
    'python-dbus-fast'
    'python-pydantic'
    'python-asyncstdlib'
    'python-pyroute2'
    'iproute2'
    'nsenter'
)
makedepends=(
    'python-setuptools'
    'python-build'
    'python-installer'
    'python-wheel'
)
backup=(
    'etc/polkit-1/rules.d/60-protonvpn-manager.rules'
)
install="${pkgname}.install"
source=()

prepare() {
    # Nothing to prepare; we build directly from source
    :
}

build() {
    # Build libvpnmanager wheel from the local source
    cd "${srcdir}/../src/libvpnmanager"
    python -m build --wheel --skip-dependency-check . --out-dir "${srcdir}"
}

package() {
    # Install Python package
    cd "${srcdir}"
    python -m installer --destdir="${pkgdir}" *.whl

    # Install daemon script
    install -Dm755 "${srcdir}/../src/daemon/daemon.py" \
        "${pkgdir}/usr/bin/proton-vpn-manager"

    # Install systemd service
    install -Dm644 "${srcdir}/../packaging/systemd/usr/lib/systemd/system/proton-vpn-manager.service" \
        "${pkgdir}/usr/lib/systemd/system/proton-vpn-manager.service"

    # Install polkit rules
    install -Dm644 "${srcdir}/../packaging/polkit/60-protonvpn-manager.rules" \
        "${pkgdir}/etc/polkit-1/rules.d/60-protonvpn-manager.rules"

    # Install documentation
    install -Dm644 "${srcdir}/../../README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../../MULTI_TUNNEL_ARCHITECTURE.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/ARCHITECTURE.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/LIBVPNMANAGER.md" 2>/dev/null || true
    install -Dm644 "${srcdir}/../../IMPLEMENTATION_REPORT.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/IMPLEMENTATION_REPORT.md" 2>/dev/null || true
}
